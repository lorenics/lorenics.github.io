<!DOCTYPE html><html lang="ja"><head><meta charset="utf-8">
<link href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;500;700;900&family=Noto+Sans+JP:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{width:1200px;height:630px;overflow:hidden}
body{position:relative;background:#fff;font-family:'Noto Sans JP',sans-serif;color:#17181c;
 background-image:linear-gradient(rgba(46,134,211,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(46,134,211,.06) 1px,transparent 1px),radial-gradient(120% 100% at 100% 0%,#e8eff8 0%,#ffffff 62%);
 background-size:48px 48px,48px 48px,100% 100%}
.hz{position:absolute;left:0;right:0;height:14px;background:repeating-linear-gradient(135deg,#2E86D3 0 22px,#0e0e0f 22px 44px)}
.hz.t{top:0}.hz.b{bottom:0}
.wrap{position:absolute;left:72px;top:64px;width:700px}
.chip{display:inline-flex;align-items:center;gap:12px;border:2px solid #cfd8e5;background:rgba(255,255,255,.92);padding:9px 16px;font-weight:700;font-size:24px;color:#30343b}
.chip i{width:12px;height:12px;border-radius:50%;background:#2E86D3;display:block}
h1{margin-top:28px;font-family:'Zen Kaku Gothic New',sans-serif;font-weight:900;font-size:86px;line-height:1.18;letter-spacing:.01em}
h1 .a{color:#2E86D3}
.sub{margin-top:26px;font-weight:700;font-size:28px;color:#3a3c42}
.foot{position:absolute;left:72px;bottom:42px;display:flex;align-items:center;gap:18px}
.foot img{height:44px;width:auto;display:block}
.foot b{font-family:'Zen Kaku Gothic New',sans-serif;font-size:25px;font-weight:700}
.foot span{font-size:21px;color:#565860;font-weight:700}
.art{position:absolute;right:-30px;bottom:14px;width:520px}
.tag{position:absolute;right:54px;top:64px;font-family:'Space Mono',monospace;font-weight:700;font-size:22px;letter-spacing:.14em;color:#2E86D3;border:2px solid #2E86D3;padding:6px 14px;background:#fff}
</style></head><body>
<div class="hz t"></div>
